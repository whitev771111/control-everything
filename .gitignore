# Local environments, caches and generated evidence
.venv/
.exe/
__pycache__/
*.py[cod]
node_modules/
/work/
/native/observer/target/
/build/
/dist/
*.egg-info/

# Publish only reviewed project documentation; keep development records local.
/docs/*
!/docs/README.md
!/docs/architecture.md
!/docs/usage.md
!/docs/workbench-contract.md
!/docs/integrations.md
!/docs/windows.md
!/docs/examples/
/docs/current/

# Local video source and renders are not publication candidates
/videos/

# Local configuration and user data
/.codex/*
/.env
/.env.*
!/.env.example
/progress-registry.json
/progress-manual.json
/progress-todos.json
*.sqlite
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.sqlite-*
*.log
