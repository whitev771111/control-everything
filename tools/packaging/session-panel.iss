; Build with the verified Inno Setup 7.1.0 compiler and generated exact includes.
#ifndef PayloadIncludeDir
  #error Supply PayloadIncludeDir generated by inno_include.py
#endif
#ifndef InstallerOutputDir
  #error Supply an owned InstallerOutputDir
#endif
#include PayloadIncludeDir + "\payload-defines.iss"

[Setup]
AppId={{A68E7F38-54DB-4A76-9DD2-89B3554F617D}
AppName=Session Panel
AppVersion={#PayloadVersion}
VersionInfoVersion={#PayloadNumericVersion}
DefaultDirName={localappdata}\Programs\SessionPanel
PrivilegesRequired=lowest
SetupArchitecture=x64
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
MinVersion=10.0
CloseApplications=no
RestartApplications=no
UninstallLogMode=append
DisableProgramGroupPage=yes
UsePreviousAppDir=yes
SetupLogging=yes
OutputDir={#InstallerOutputDir}
OutputBaseFilename=session-panel-{#PayloadVersion}-windows-x64
Compression=lzma2
SolidCompression=no
WizardStyle=modern

[Files]
#include PayloadIncludeDir + "\payload-files.iss"

[Icons]
Name: "{userprograms}\Session Panel"; Filename: "{app}\session-panel.cmd"; WorkingDir: "{app}"

[Code]
const
  MutexPrefix = 'Global\SessionPanel.Install.';
  UninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{A68E7F38-54DB-4A76-9DD2-89B3554F617D}_is1';
  ReparseAttribute = $400;
  InvalidAttributes = $FFFFFFFF;

type
  TMutexSecurityAttributes = record
    Length: DWORD;
    Padding1: DWORD;
    Descriptor: NativeUInt;
    InheritHandle: DWORD;
    Padding2: DWORD;
  end;

var
  PayloadPaths, PayloadHashes: TArrayOfString;
  BootstrapRoot, ContextFile, PreflightReceipt, Operation: String;
  MaintenanceHandle: THandle;
  MaintenanceHeld, BootstrapExtracted, Prepared, InstallPayload, InstallCommitted: Boolean;
  ReportSequence: Integer;

function NativeCreateMutex(var Attributes: TMutexSecurityAttributes; InitialOwner: BOOL; Name: String): THandle;
  external 'CreateMutexW@kernel32.dll stdcall';
function NativeWait(Handle: THandle; Milliseconds: DWORD): DWORD;
  external 'WaitForSingleObject@kernel32.dll stdcall';
function NativeReleaseMutex(Handle: THandle): BOOL;
  external 'ReleaseMutex@kernel32.dll stdcall';
function NativeCloseHandle(Handle: THandle): BOOL;
  external 'CloseHandle@kernel32.dll stdcall';
function NativeLocalFree(Address: NativeUInt): NativeUInt;
  external 'LocalFree@kernel32.dll stdcall';
function ConvertSecurityDescriptor(Text: String; Revision: DWORD; var Descriptor: NativeUInt; Size: NativeUInt): BOOL;
  external 'ConvertStringSecurityDescriptorToSecurityDescriptorW@advapi32.dll stdcall';
function NativeFileAttributes(Name: String): DWORD;
  external 'GetFileAttributesW@kernel32.dll stdcall';

#include PayloadIncludeDir + "\payload-hashes.iss"

function QuoteArgument(Value: String): String;
var I, J, Slashes: Integer;
begin
  Result := '"';
  Slashes := 0;
  for I := 1 to Length(Value) do begin
    if Value[I] = '\' then
      Slashes := Slashes + 1
    else begin
      if Value[I] = '"' then begin
        for J := 1 to Slashes * 2 + 1 do Result := Result + '\';
      end else
        for J := 1 to Slashes do Result := Result + '\';
      Result := Result + Value[I];
      Slashes := 0;
    end;
  end;
  for J := 1 to Slashes * 2 do Result := Result + '\';
  Result := Result + '"';
end;

procedure RequireNoReparse(Path: String);
var Current, Parent: String; Attributes: DWORD;
begin
  Current := ExpandFileName(Path);
  while Current <> '' do begin
    Attributes := NativeFileAttributes(Current);
    if Attributes = InvalidAttributes then begin
      if (DLLGetLastError <> 2) and (DLLGetLastError <> 3) then
        RaiseException('无法核验安装路径。');
    end else if (Attributes and ReparseAttribute) <> 0 then
      RaiseException('安装路径不能包含链接或重解析点。');
    Parent := ExtractFileDir(Current);
    if CompareText(Parent, Current) = 0 then Break;
    Current := Parent;
  end;
end;

function InstalledVersionRoot: String;
begin
  Result := AddBackslash(ExpandConstant('{app}')) + 'versions\{#PayloadId}';
end;

procedure RequireSupportedInstallPaths;
var I: Integer;
begin
  for I := 0 to GetArrayLength(PayloadPaths) - 1 do
    if Length(AddBackslash(InstalledVersionRoot) + PayloadPaths[I]) >= 260 then
      RaiseException('安装目录过长，请选择更短的目录；完整文件路径必须少于260个UTF-16字符。');
end;

function NewReport(Stage: String): String;
begin
  ReportSequence := ReportSequence + 1;
  Result := AddBackslash(ExpandConstant('{tmp}')) + 'maintenance-' + Stage + '-' + IntToStr(ReportSequence) + '.json';
end;

procedure VerifyTable(Root: String);
var I: Integer; FileName: String;
begin
  RequireNoReparse(Root);
  for I := 0 to GetArrayLength(PayloadPaths) - 1 do begin
    FileName := AddBackslash(Root) + PayloadPaths[I];
    RequireNoReparse(FileName);
    if not FileExists(FileName) then RaiseException('完整安装文件缺失，需使用可信安装器修复。');
    if CompareText(GetSHA256OfFile(FileName), PayloadHashes[I]) <> 0 then
      RaiseException('完整安装文件校验失败，已停止维护。');
  end;
end;

procedure LogJsonReport(Report: String);
var Lines: TArrayOfString; I: Integer;
begin
  if not LoadStringsFromFile(Report, Lines) or (GetArrayLength(Lines) = 0) then
    RaiseException('维护报告缺失。');
  for I := 0 to GetArrayLength(Lines) - 1 do Log('Session Panel maintenance JSON: ' + Lines[I]);
end;

procedure CheckReport(Report, ExpectedStatus: String);
var Projection: String;
begin
  Projection := ChangeFileExt(Report, '.ini');
  if (GetIniString('maintenance', 'status', '', Projection) <> ExpectedStatus) or
     (GetIniString('maintenance', 'operation', '', Projection) <> Operation) or
     (GetIniString('maintenance', 'version_id', '', Projection) <> '{#PayloadId}') or
     (GetIniString('maintenance', 'closure', '', Projection) <> '{#PayloadClosure}') then
    RaiseException('维护报告与本安装器不匹配。');
end;

procedure RunMaintenance(Command, Report, Payload, Receipt, ExpectedStatus: String; UseInvocation: Boolean);
var Parameters: String; ExitCode: Integer; Started: Boolean;
begin
  VerifyTable(BootstrapRoot);
  Parameters := '-I -B -X utf8 -m control_everything.installation.maintenance ' + Command +
    ' --install-root ' + QuoteArgument(ExpandConstant('{app}')) +
    ' --operation ' + Operation + ' --report ' + QuoteArgument(Report);
  if UseInvocation then Parameters := Parameters + ' --invocation-file ' + QuoteArgument(ContextFile);
  if Payload <> '' then Parameters := Parameters + ' --payload ' + QuoteArgument(Payload);
  if Receipt <> '' then Parameters := Parameters + ' --receipt-file ' + QuoteArgument(Receipt);
  Started := Exec(AddBackslash(BootstrapRoot) + 'runtime\python.exe', Parameters,
    BootstrapRoot, SW_HIDE, ewWaitUntilTerminated, ExitCode);
  if not Started then RaiseException('无法启动已校验的私有维护程序。');
  Log('Session Panel maintenance ' + Command + ' exit=' + IntToStr(ExitCode));
  if ExitCode <> 0 then begin
    if FileExists(Report) then LogJsonReport(Report);
    case ExitCode of
      20: RaiseException('请取消本次安装，正常退出本安装的网关后重试。');
      21: RaiseException('安装内存在未知或身份无法核验的进程，请正常退出后重试。');
      22: RaiseException('原生后台未能正常退出，旧安装保持不变。');
      23: RaiseException('安装文件仍被占用，请正常退出相关实例后重试。');
      24: RaiseException('安装记录或文件不完整，需使用可信安装器修复。');
      25: RaiseException('另一个安装维护操作正在进行。');
      26: RaiseException('文件访问或维护未完成，请保留安装日志。');
    else
      RaiseException('维护未完成；请保留安装日志后重试。');
    end;
  end;
  LogJsonReport(Report);
  CheckReport(Report, ExpectedStatus);
end;

procedure ReleaseMaintenance;
begin
  if MaintenanceHandle <> 0 then begin
    if MaintenanceHeld then begin
      if not NativeReleaseMutex(MaintenanceHandle) then Log('Session Panel ReleaseMutex failed.');
      MaintenanceHeld := False;
    end;
    if not NativeCloseHandle(MaintenanceHandle) then Log('Session Panel CloseHandle failed.');
    MaintenanceHandle := 0;
  end;
end;

procedure AcquireMaintenance;
var Name, Sddl, Suffix: String; Descriptor: NativeUInt; Attributes: TMutexSecurityAttributes;
    WaitResult: DWORD; I: Integer;
begin
  Name := GetIniString('mutex', 'name', '', ChangeFileExt(ContextFile, '.ini'));
  Sddl := GetIniString('mutex', 'sddl', '', ChangeFileExt(ContextFile, '.ini'));
  Suffix := Copy(Name, Length(MutexPrefix) + 1, MaxInt);
  if (Copy(Name, 1, Length(MutexPrefix)) <> MutexPrefix) or (Length(Suffix) <> 64) or (Sddl = '') then
    RaiseException('维护锁上下文无效。');
  for I := 1 to Length(Suffix) do
    if Pos(Suffix[I], '0123456789abcdef') = 0 then RaiseException('维护锁上下文无效。');
  Descriptor := 0;
  if not ConvertSecurityDescriptor(Sddl, 1, Descriptor, 0) then RaiseException('无法建立用户维护锁权限。');
  try
    Attributes.Length := SizeOf(Attributes);
    Attributes.Padding1 := 0;
    Attributes.Descriptor := Descriptor;
    Attributes.InheritHandle := 0;
    Attributes.Padding2 := 0;
    if Attributes.Length <> 24 then RaiseException('安装器安全结构不兼容。');
    MaintenanceHandle := NativeCreateMutex(Attributes, False, Name);
    if MaintenanceHandle = 0 then RaiseException('无法创建安装维护锁。');
  finally
    if NativeLocalFree(Descriptor) <> 0 then Log('Session Panel security descriptor release failed.');
  end;
  WaitResult := NativeWait(MaintenanceHandle, 0);
  MaintenanceHeld := (WaitResult = 0) or (WaitResult = $80);
  if WaitResult = $102 then RaiseException('另一个安装维护操作正在进行。');
  if WaitResult <> 0 then RaiseException('安装维护锁未能正常获取。');
end;

function ShouldInstallPayload: Boolean;
begin
  Result := InstallPayload;
end;

function InitializeSetup: Boolean;
begin
  LoadPayloadTable;
  InstallPayload := True;
  Result := True;
end;

procedure EnsureDefaultParent;
var Parent, DefaultParent, App: String;
begin
  App := ExpandFileName(ExpandConstant('{app}'));
  Parent := ExtractFileDir(App);
  RequireNoReparse(Parent);
  if DirExists(Parent) then Exit;
  DefaultParent := AddBackslash(ExpandConstant('{localappdata}')) + 'Programs';
  if (CompareText(Parent, DefaultParent) <> 0) or
     (CompareText(App, AddBackslash(DefaultParent) + 'SessionPanel') <> 0) then
    RaiseException('请先选择一个已存在的安装父目录。');
  if not DirExists(ExpandConstant('{localappdata}')) then RaiseException('当前用户目录不可用。');
  if not CreateDir(DefaultParent) and not DirExists(DefaultParent) then
    RaiseException('无法创建当前用户的程序父目录。');
  RequireNoReparse(DefaultParent);
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := '';
  NeedsRestart := False;
  Prepared := False;
  try
    ReleaseMaintenance;
    RequireSupportedInstallPaths;
    if not BootstrapExtracted then begin
      ExtractTemporaryFiles('{app}\versions\{#PayloadId}\*');
      BootstrapRoot := AddBackslash(ExpandConstant('{tmp}')) + '{app}\versions\{#PayloadId}';
      BootstrapExtracted := True;
    end;
    VerifyTable(BootstrapRoot);
    EnsureDefaultParent;
    Operation := 'install';
    if FileExists(AddBackslash(ExpandConstant('{app}')) + '.install\root.json') then Operation := 'upgrade';
    ContextFile := NewReport('context');
    RunMaintenance('prepare', ContextFile, '', '', 'prepared', False);
    AcquireMaintenance;
    PreflightReceipt := NewReport('preflight');
    RunMaintenance('preflight', PreflightReceipt, '', '', 'ready', True);
    RequireNoReparse(InstalledVersionRoot);
    InstallPayload := not DirExists(InstalledVersionRoot);
    if not InstallPayload then begin
      VerifyTable(InstalledVersionRoot);
      RunMaintenance('verify', NewReport('existing'), InstalledVersionRoot, '', 'ready', True);
    end;
    Prepared := True;
  except
    Result := GetExceptionMessage;
    Log('Session Panel preflight blocked: ' + Result);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then begin
    if not Prepared or not MaintenanceHeld then RaiseException('安装未经过维护预检。');
    VerifyTable(InstalledVersionRoot);
    RunMaintenance('verify', NewReport('verify'), InstalledVersionRoot, '', 'ready', True);
    RunMaintenance('commit', NewReport('commit'), InstalledVersionRoot, PreflightReceipt, 'committed', True);
    InstallCommitted := True;
  end;
end;

function GetCustomSetupExitCode: Integer;
begin
  Result := 0;
  if not InstallCommitted then Result := 26;
end;

procedure CopyBoundUninstallBootstrap;
var I: Integer; Source, Destination: String;
begin
  VerifyTable(InstalledVersionRoot);
  BootstrapRoot := AddBackslash(ExpandConstant('{tmp}')) + '{app}\versions\{#PayloadId}';
  if DirExists(BootstrapRoot) then RaiseException('卸载临时目录冲突。');
  for I := 0 to GetArrayLength(PayloadPaths) - 1 do begin
    Source := AddBackslash(InstalledVersionRoot) + PayloadPaths[I];
    Destination := AddBackslash(BootstrapRoot) + PayloadPaths[I];
    RequireNoReparse(Source);
    RequireNoReparse(Destination);
    if not ForceDirectories(ExtractFileDir(Destination)) then RaiseException('无法创建私有卸载目录。');
    if not CopyFile(Source, Destination, True) then RaiseException('无法复制已登记的卸载文件。');
    if CompareText(GetSHA256OfFile(Destination), PayloadHashes[I]) <> 0 then
      RaiseException('卸载文件副本校验失败。');
  end;
  VerifyTable(BootstrapRoot);
end;

function InitializeUninstall: Boolean;
var Registered: String;
begin
  Result := False;
  try
    LoadPayloadTable;
    if not RegQueryStringValue(HKCU, UninstallKey, 'UninstallString', Registered) or
       (CompareText(ExpandFileName(RemoveQuotes(Registered)), ExpandFileName(ExpandConstant('{uninstallexe}'))) <> 0) then
      RaiseException('卸载入口与当前用户安装登记不匹配。');
    CopyBoundUninstallBootstrap;
    Operation := 'uninstall';
    ContextFile := NewReport('context');
    RunMaintenance('prepare', ContextFile, '', '', 'prepared', False);
    AcquireMaintenance;
    PreflightReceipt := NewReport('preflight');
    RunMaintenance('preflight', PreflightReceipt, '', '', 'ready', True);
    Prepared := True;
    Result := True;
  except
    Log('Session Panel uninstall blocked: ' + GetExceptionMessage);
    SuppressibleMsgBox(GetExceptionMessage, mbError, MB_OK, IDOK);
    ReleaseMaintenance;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then begin
    if not Prepared or not MaintenanceHeld then RaiseException('卸载未经过维护预检。');
    RunMaintenance('commit', NewReport('commit'), InstalledVersionRoot, PreflightReceipt, 'committed', True);
  end;
end;

procedure DeinitializeSetup;
begin
  ReleaseMaintenance;
end;

procedure DeinitializeUninstall;
begin
  ReleaseMaintenance;
end;
